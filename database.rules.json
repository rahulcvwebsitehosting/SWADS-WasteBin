{
  "rules": {
    "swads": {
      "v1": {
        "bins": {
          ".read": "auth != null && query.orderByChild == 'ownerUid' && query.equalTo == auth.uid",
          ".indexOn": [
            "ownerUid"
          ],
          "$binId": {
            ".write": false,
            ".read": "auth != null && data.child('ownerUid').val() === auth.uid"
          }
        },
        "devices": {
          "$deviceId": {
            ".read": "auth != null && (root.child('swads/v1/deviceUsers').child(auth.uid).child($deviceId).val() === true || root.child('swads/v1/deviceRegistry').child($deviceId).child('ownerUid').val() === auth.uid)",
            "config": {
              ".write": false,
              ".validate": "newData.child('binId').val() === root.child('swads/v1/deviceRegistry').child($deviceId).child('binId').val() && newData.child('binHeightCm').isNumber() && newData.child('binHeightCm').val() >= 10 && newData.child('binHeightCm').val() <= 350"
            },
            "info": {
              ".write": "auth != null && newData.exists() && root.child('swads/v1/deviceUsers').child(auth.uid).child($deviceId).val() === true",
              ".validate": "newData.child('deviceId').val() === $deviceId && newData.child('binId').val() === root.child('swads/v1/deviceRegistry').child($deviceId).child('binId').val()"
            },
            "state": {
              ".write": "auth != null && newData.exists() && root.child('swads/v1/deviceUsers').child(auth.uid).child($deviceId).val() === true",
              ".validate": "newData.child('deviceId').val() === $deviceId && newData.child('binId').val() === root.child('swads/v1/deviceRegistry').child($deviceId).child('binId').val() && (newData.child('state').val() === 'NORMAL' || newData.child('state').val() === 'CRITICAL') && (!newData.child('measurement/fillPercent').exists() || (newData.child('measurement/fillPercent').isNumber() && newData.child('measurement/fillPercent').val() >= 0 && newData.child('measurement/fillPercent').val() <= 100)) && newData.child('latestEventSequence').isNumber() && newData.child('latestEventSequence').val() >= 0"
            },
            "heartbeat": {
              ".write": "auth != null && newData.exists() && root.child('swads/v1/deviceUsers').child(auth.uid).child($deviceId).val() === true",
              ".validate": "newData.child('deviceId').val() === $deviceId && newData.child('binId').val() === root.child('swads/v1/deviceRegistry').child($deviceId).child('binId').val()"
            },
            "telemetry": {
              "$telemetryId": {
                ".write": "auth != null && newData.exists() && root.child('swads/v1/deviceUsers').child(auth.uid).child($deviceId).val() === true",
                ".validate": "newData.child('telemetryId').val() === $telemetryId && newData.child('deviceId').val() === $deviceId && newData.child('binId').val() === root.child('swads/v1/deviceRegistry').child($deviceId).child('binId').val()"
              }
            }
          }
        },
        "events": {
          "$eventId": {
            ".read": "auth != null && root.child('swads/v1/bins').child(data.child('binId').val()).child('ownerUid').val() === auth.uid",
            ".write": "auth != null && newData.exists() && newData.child('eventId').val() === $eventId && newData.child('deviceId').isString() && newData.child('binId').isString() && (newData.child('type').val() === 'ALERT_80' || newData.child('type').val() === 'RESET') && root.child('swads/v1/deviceUsers').child(auth.uid).child(newData.child('deviceId').val()).val() === true && root.child('swads/v1/deviceRegistry').child(newData.child('deviceId').val()).child('binId').val() === newData.child('binId').val() && (!data.exists() || (newData.child('eventId').val() === data.child('eventId').val() && newData.child('type').val() === data.child('type').val() && newData.child('deviceId').val() === data.child('deviceId').val() && newData.child('binId').val() === data.child('binId').val() && newData.child('alertCycleId').val() === data.child('alertCycleId').val())) && newData.child('deviceEventSequence').isNumber() && newData.child('deviceEventSequence').val() > 0 && newData.child('alertCycleId').isString()"
          }
        },
        "eventBackend": {
          "$eventId": {
            ".read": "auth != null && root.child('swads/v1/bins').child(root.child('swads/v1/events').child($eventId).child('binId').val()).child('ownerUid').val() === auth.uid",
            ".write": false
          }
        },
        "deviceRegistry": {
          "$deviceId": {
            ".read": "auth != null && data.child('ownerUid').val() === auth.uid",
            ".write": false
          }
        },
        "deviceUsers": {
          ".read": false,
          ".write": false
        },
        "activeAlerts": {
          "$binId": {
            ".read": "auth != null && root.child('swads/v1/bins').child($binId).child('ownerUid').val() === auth.uid",
            ".write": false
          }
        },
        "alertCycles": {
          "$cycleId": {
            ".read": "auth != null && data.child('ownerUid').val() === auth.uid",
            ".write": false
          }
        },
        "users": {
          "$uid": {
            "googleOAuth": {
              ".read": false,
              ".write": false
            },
            "fcmTokens": {
              ".write": "auth != null && auth.uid === $uid",
              "$installationId": {
                ".validate": "!newData.exists() || (newData.isString() && newData.val().length > 0 && newData.val().length <= 4096)"
              }
            }
          }
        },
        "dispatchJobs": {
          ".read": false,
          ".write": false,
          ".indexOn": [
            "nextAttemptAt"
          ]
        }
      }
    }
  }
}
